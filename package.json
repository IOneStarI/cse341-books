{
  "name": "cse341-books",
  "version": "1.0.0",
  "private": true,
  "description": "Books API for CSE 341",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "swagger": "node swagger.js",
    "seed:authors": "node --env-file=.env scripts/seed-authors.js",
    "test": "node --env-file=.env --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.3.0"
  }
