{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "birthYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "example": "a1"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Maya Rivera"
          },
          "birthYear": {
            "type": "integer",
            "minimum": 1,
            "description": "Must not exceed the current UTC year.",
            "example": 1980
          }
        }
      },
      "AuthorUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "birthYear"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Author/properties/name"
          },
          "birthYear": {
            "$ref": "#/components/schemas/Author/properties/birthYear"
          }
        }
      },
      "Book": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "example": "b1"
          },
          "authorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Custom id of an existing author.",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Patterns of Light"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "Real calendar date in YYYY-MM-DD, years 0001 through 9999.",
            "example": "2021-08-17"
          }
        }
      },
      "BookUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "authorId": {
            "$ref": "#/components/schemas/Book/properties/authorId"
          },
          "title": {
            "$ref": "#/components/schemas/Book/properties/title"
          },
          "publicationDate": {
            "$ref": "#/components/schemas/Book/properties/publicationDate"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BookNotFound": {
        "description": "No book matches the custom id.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "Book not found"
            }
          }
        }
      },
      "InvalidBook": {
        "description": "Invalid book data, malformed JSON, or an authorId that does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "invalid": {
                "value": {
                  "message": "Invalid book data"
                }
              },
              "authorMissing": {
                "value": {
                  "message": "Author does not exist"
                }
              },
              "malformed": {
                "value": {
                  "message": "Invalid request body"
                }
              }
            }
          }
        }
      },
      "AuthorNotFound": {
        "description": "No author matches the custom id.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "Author not found"
            }
          }
        }
      },
      "InvalidAuthor": {
        "description": "Missing or invalid data, unexpected fields, or malformed JSON.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "invalid": {
                "value": {
                  "message": "Invalid author data"
                }
              },
              "malformed": {
                "value": {
                  "message": "Invalid request body"
                }
              }
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server or database error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      },
      "BodyTooLarge": {
        "description": "JSON body exceeds the 100 KB request limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "Request body too large"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "All books, ordered by custom id; an empty collection returns an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "description": "All four fields are required. Strings are trimmed, unknown fields are rejected, and authorId must identify an existing author. Ids are unique and case-sensitive. Publication dates must be real calendar dates.",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              },
              "example": {
                "id": "b4",
                "authorId": "a1",
                "title": "Example Book Title",
                "publicationDate": "2026-01-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created, with its author reference and no internal MongoDB fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data, malformed JSON, duplicate id, or a missing author.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid": {
                    "value": {
                      "message": "Invalid book data"
                    }
                  },
                  "duplicate": {
                    "value": {
                      "message": "Book id already exists"
                    }
                  },
                  "authorMissing": {
                    "value": {
                      "message": "Author does not exist"
                    }
                  },
                  "malformed": {
                    "value": {
                      "message": "Invalid request body"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Get one book by custom id",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Custom book id, such as b1; not a MongoDB ObjectId.",
            "schema": {
              "type": "string"
            },
            "example": "b1"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching book.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "No book matches the supplied id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "description": "All three mutable fields are required. The id cannot change or appear in the body. A missing book returns 404 before author lookup; a missing author returns 400. Unchanged valid updates return 200.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              },
              "example": {
                "authorId": "a2",
                "title": "Updated Book Title",
                "publicationDate": "2026-02-20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated book, with the original id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidBook"
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "description": "Deletes only the matching book; its author is retained.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b4"
          }
        ],
        "responses": {
          "204": {
            "description": "Book deleted; response has no body."
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "Authors sorted by custom id; an empty collection returns an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Author"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "description": "All fields are required. Strings are trimmed. Custom ids are unique and case-sensitive. Birth year must be an integer from 1 through the current UTC year. Unknown fields are rejected.",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              },
              "example": {
                "id": "a4",
                "name": "Example Author",
                "birthYear": 1980
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "description": "Invalid author data, malformed JSON, or an id that already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid": {
                    "value": {
                      "message": "Invalid author data"
                    }
                  },
                  "duplicate": {
                    "value": {
                      "message": "Author id already exists"
                    }
                  },
                  "malformed": {
                    "value": {
                      "message": "Invalid request body"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get one author by custom id",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching author, without MongoDB internal fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Update an author",
        "description": "Both mutable fields are required, strings are trimmed, and the id cannot change or appear in the body. A valid unchanged update returns 200.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a4"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorUpdate"
              },
              "example": {
                "name": "Updated Author",
                "birthYear": 1981
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated author, with its original id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidAuthor"
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete an author who has no books",
        "description": "Blocks deletion while any book references the authorId. Books are never cascade-deleted.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a4"
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted; response has no body."
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "409": {
            "description": "Author still has books; no documents are removed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Author cannot be deleted because they still have books"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "tags": []
}
